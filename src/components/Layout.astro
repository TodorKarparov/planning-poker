---
import '../styles/app.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#9381ff"/><title>{title} · Planning poker</title>
  <!-- TODO: Download these fonts and their licenses, serve local WOFF2 files, and remove the Google Fonts links. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Lobster&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body><slot/><noscript><p>Enable JavaScript to join and vote in real time.</p></noscript></body></html>
